animations {
    // Using 'spring' gives you the bouncy, overshoot effect
    // damping-ratio < 1.0 creates the bounce. Stiffness controls the speed.
    window-open {
        spring damping-ratio=0.7 stiffness=150 epsilon=0.00001
    }
    window-close {
        spring damping-ratio=0.7 stiffness=150 epsilon=0.00001
    }
    horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=150 epsilon=0.00001
    }
    window-movement {
        spring damping-ratio=0.7 stiffness=150 epsilon=0.00001
    }
    workspace-switch {
        spring damping-ratio=0.7 stiffness=150 epsilon=0.00001
    }
}
